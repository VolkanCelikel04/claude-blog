{
  "name": "vgantt",
  "version": "0.1.0",
  "private": true,
  "description": "Vgantt - modular multi-tenant SaaS (PostgreSQL + NestJS + React + Electron)",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "db:migrate": "db/migrate.sh --seed",
    "db:reset": "db/migrate.sh --reset --demo",
    "db:test": "db/tests/run.sh",
    "test:vault": "npm run test --workspace @vgantt/vault-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace @vgantt/api",
    "dev:web": "npm run dev --workspace @vgantt/web",
    "dev:desktop": "npm run start --workspace @vgantt/desktop"
  },
  "engines": { "node": ">=22.6.0" }
}
