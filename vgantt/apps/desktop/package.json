{
  "name": "@vgantt/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Vgantt Suite desktop shell. Hosts the web UI and owns the local Rsdw vault.",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build --workspace @vgantt/vault-core && tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vgantt/vault-core": "file:../../packages/vault-core"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.vgantt.suite",
    "productName": "Vgantt Suite",
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "extraResources": []
  },
  "type": "module"
}
