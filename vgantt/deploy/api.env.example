# ---------------------------------------------------------------------------
# Vgantt Suite - /etc/vgantt/api.env      chown root:vgantt   chmod 0640
#
# Production settings for a single-server install (API + PostgreSQL together).
# Copy this file, fill in the three secrets, and never commit the result.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Loopback only: nginx on this same host is the public entry point.
HOST=127.0.0.1
API_PREFIX=api

# The origins allowed to call the API from a browser. The frontend is served
# from this same origin, so this list mainly exists for the desktop shell and
# for any future subdomain.
CORS_ORIGINS=https://suite.vgantt.com

# --- PostgreSQL (same machine, over loopback) ------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vgantt
DB_SSL=false

# Two roles on purpose. The app role cannot bypass row level security; the
# platform role can and is only used by /api/admin routes.
DB_APP_USER=vgantt_api
DB_APP_PASSWORD=__DEGISTIRIN__
DB_APP_POOL_MAX=20

DB_PLATFORM_USER=vgantt_platform_api
DB_PLATFORM_PASSWORD=__DEGISTIRIN__
DB_PLATFORM_POOL_MAX=5

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters; the API refuses to start in production otherwise.
# Generate with:  openssl rand -base64 48
JWT_SECRET=__DEGISTIRIN__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_MIN_LENGTH=10

# --- Alerts ----------------------------------------------------------------
# Nightly maintenance + the 30/15/7/3 warning ladder, in the server's local time.
ALERTS_ENABLED=true
ALERTS_CRON=0 6 * * *
MAIL_FROM=bildirim@vgantt.com
MAIL_TRANSPORT=console
MAIL_SMTP_URL=
ALERT_WEBHOOK_URL=
