{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // TypeScript 5.7+: lets the sources keep explicit .ts specifiers (which is
    // what makes `node --experimental-strip-types` run them directly, with no
    // build step during development) while emitting .js specifiers to dist.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*"]
}
